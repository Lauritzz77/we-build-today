---
import { Mail } from "@lucide/astro";
import Base from "../layouts/Base.astro";
---

<Base title="We Build Today">
  <main class="flex min-h-screen flex-col items-center justify-center px-6 relative z-10">
    <h1 class="clamp-[text,3xl,9xl] font-bold">We Build Today</h1>
    <p class="clamp-[text,lg,2xl] clamp-[mt,4,8] max-w-2xl text-center text-gray-600">
      Websites. Tools. AI stuff. Fast ones. Accessible ones. You need it. We build it. Today.
    </p>
    <a
      href="mailto:hello@webuild.today"
      class="clamp-[text,base,2xl] clamp-[px,6,10] clamp-[py,2.5,4] clamp-[mt,6,10] clamp-[gap,2,3] inline-flex items-center rounded-full bg-[hsl(168,73%,39%)] font-medium text-white transition-colors hover:bg-[hsl(168,73%,39%)]/80"
    >
      <Mail class="clamp-[size,4,7]" />
      Let's build
    </a>
  </main>

  <div class="pointer-events-none fixed inset-x-0 bottom-0 h-200 overflow-hidden" aria-hidden="true">
    <div class="rising-blocks">
      <span style="--x: 5%; --delay: 0s; --duration: 4s; --size: 12px;"></span>
      <span style="--x: 15%; --delay: 1.2s; --duration: 5s; --size: 8px;"></span>
      <span style="--x: 25%; --delay: 0.5s; --duration: 3.5s; --size: 16px;"></span>
      <span style="--x: 35%; --delay: 2s; --duration: 4.5s; --size: 10px;"></span>
      <span style="--x: 45%; --delay: 0.8s; --duration: 5.5s; --size: 14px;"></span>
      <span style="--x: 55%; --delay: 1.5s; --duration: 3.8s; --size: 9px;"></span>
      <span style="--x: 65%; --delay: 0.3s; --duration: 4.2s; --size: 18px;"></span>
      <span style="--x: 75%; --delay: 2.5s; --duration: 5.2s; --size: 11px;"></span>
      <span style="--x: 85%; --delay: 1s; --duration: 3.2s; --size: 13px;"></span>
      <span style="--x: 92%; --delay: 1.8s; --duration: 4.8s; --size: 7px;"></span>
    </div>
  </div>

  <div class="pointer-events-none fixed inset-x-0 top-0 h-200 overflow-hidden" aria-hidden="true">
    <div class="falling-blocks">
      <span style="--x: 8%; --delay: 0.6s; --duration: 4.3s; --size: 10px;"></span>
      <span style="--x: 18%; --delay: 1.8s; --duration: 5.1s; --size: 14px;"></span>
      <span style="--x: 28%; --delay: 0.2s; --duration: 3.6s; --size: 8px;"></span>
      <span style="--x: 38%; --delay: 2.3s; --duration: 4.7s; --size: 16px;"></span>
      <span style="--x: 48%; --delay: 1s; --duration: 5.3s; --size: 11px;"></span>
      <span style="--x: 58%; --delay: 0.4s; --duration: 3.9s; --size: 13px;"></span>
      <span style="--x: 68%; --delay: 1.6s; --duration: 4.4s; --size: 7px;"></span>
      <span style="--x: 78%; --delay: 2.1s; --duration: 5.5s; --size: 18px;"></span>
      <span style="--x: 88%; --delay: 0.9s; --duration: 3.4s; --size: 9px;"></span>
      <span style="--x: 95%; --delay: 1.4s; --duration: 4.9s; --size: 12px;"></span>
    </div>
  </div>

  <style>
    .rising-blocks,
    .falling-blocks {
      position: absolute;
      inset: 0;
    }

    .rising-blocks span {
      position: absolute;
      bottom: -20px;
      left: var(--x);
      width: var(--size);
      height: var(--size);
      background: hsl(168, 73%, 39%);
      opacity: 1;
      border-radius: 2px;
      animation: rise var(--duration) var(--delay) ease-in infinite;
    }

    .falling-blocks span {
      position: absolute;
      top: 0;
      left: var(--x);
      width: var(--size);
      height: var(--size);
      background: hsl(168, 73%, 39%);
      opacity: 0;
      border-radius: 2px;
      animation: fall var(--duration) var(--delay) ease-out infinite;
    }

    @keyframes rise {
      0% {
        transform: translateY(0) rotate(0deg);
        opacity: 0.15;
      }
      50% {
        opacity: 0.25;
      }
      100% {
        transform: translateY(-140px) rotate(45deg);
        opacity: 0;
      }
    }

    @keyframes fall {
      0% {
        transform: translateY(-20px) rotate(0deg);
        opacity: 0;
      }
      15% {
        opacity: 0.2;
      }
      50% {
        opacity: 0.25;
      }
      100% {
        transform: translateY(130px) rotate(-45deg);
        opacity: 0;
      }
    }
  </style>
</Base>
