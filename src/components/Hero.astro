---
import { Mail } from "@lucide/astro";
---

<main class="flex min-h-screen flex-col items-center justify-center px-6 relative z-10">
  <h1 class="clamp-[text,3xl,9xl] font-bold">We Build Today</h1>
  <p class="clamp-[text,lg,2xl] clamp-[mt,4,8] max-w-2xl text-center text-gray-600">
    Websites. Tools. AI stuff. Fast ones. Accessible ones. You need it. We build it. Today.
  </p>
  <a
    href="mailto:hello@webuild.today"
    class="clamp-[text,base,2xl] clamp-[px,6,10] clamp-[py,2.5,4] clamp-[mt,6,10] clamp-[gap,2,3] inline-flex items-center rounded-full bg-[hsl(168,73%,39%)] font-medium text-white transition-colors hover:bg-[hsl(168,73%,39%)]/80"
  >
    <Mail class="clamp-[size,4,7]" />
    Let's build
  </a>
</main>
