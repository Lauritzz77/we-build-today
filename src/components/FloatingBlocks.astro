<style>
  .rising-blocks,
  .falling-blocks {
    position: absolute;
    inset: 0;
  }

  .rising-blocks span {
    position: absolute;
    bottom: -20px;
    left: var(--x);
    width: var(--size);
    height: var(--size);
    background: hsl(168, 73%, 39%);
    opacity: 1;
