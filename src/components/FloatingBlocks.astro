    width: var(--size);
    height: var(--size);
    background: hsl(168, 73%, 39%);
    opacity: 0;
    border-radius: 2px;
    animation: fall var(--duration) var(--delay) ease-out infinite;
  }

  @keyframes rise {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 0.15;
    }
    50% {
      opacity: 0.25;
    }
    100% {
      transform: translateY(-140px) rotate(45deg);
      opacity: 0;
    }
  }

  @keyframes fall {
    0% {
      transform: translateY(-20px) rotate(0deg);
      opacity: 0;
    }
    15% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.25;
    }
    100% {
      transform: translateY(130px) rotate(-45deg);
      opacity: 0;
    }
  }
</style>
